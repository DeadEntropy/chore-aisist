# Local development settings (copy to .env, chmod 600). Never commit .env.
# Database: the chore-aisist-db container, reachable from this machine on 127.0.0.1:3307.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=chores
DB_USER=chore_aisist
DB_PASSWORD=change-me

# Nextcloud (CalDAV) as the ChoreAisist user. See CALENDAR.md. Leave CALDAV_URL unset to plan without calendars.
NEXTCLOUD_USER=ChoreAisist
NEXTCLOUD_APP_PASSWORD=change-me
CALDAV_URL=https://nextcloud.local/remote.php/dav
CALDAV_CA_CERT=/path/to/homelab-ca.crt
CHORES_CALENDAR_URI=chores

# Calendars whose events block people: <calendar-uri>=<person>[,<person>]; ...
# (URIs as the ChoreAisist user sees them, e.g. family_shared_by_<owner>)
BUSY_CALENDARS=personal_shared_by_<owner>=nicolas;family_shared_by_<owner>=nicolas,anna;school_shared_by_<owner>=nicolas,anna;personal_shared_by_<spouse>=anna

# Minutes added before and after every busy timed event
EVENT_BUFFER_MINUTES=30

# When chores can be planned by default (both people): "<day> HH:MM-HH:MM; ..."
CHORE_WINDOWS=sat 08:00-18:00; sun 08:00-18:00
# Chore window on a day made available by a "Day off" / "Holiday" all-day event
EXTRA_DAY_WINDOW=08:00-18:00

# Calendar title keywords (match the start of a word, case-insensitive; comma-separated):
# all-day: travel → away; "No chores" → no chores that day; "Day off"/"Holiday" → whole day available
# timed:   "Chores" → that time is available (on the calendar's people)
TRAVEL_KEYWORDS=travel,trip,away
NO_CHORES_KEYWORDS=no chores
DAY_OFF_KEYWORDS=day off,holiday
CHORE_TIME_KEYWORDS=chore
PLANNER_TIMEZONE=America/New_York
# Seconds before a CalDAV request gives up
CALDAV_TIMEOUT_SECONDS=30
# Phone reminder before each planned chore, in minutes (0 = no reminder)
REMINDER_MINUTES=30
# Weather for outdoor chores (Open-Meteo, no key). Unset latitude/longitude = no weather.
#WEATHER_LATITUDE=<latitude>
#WEATHER_LONGITUDE=<longitude>
# Forecast used for today and this many days after; models preferred first (each value from the first that has it)
WEATHER_DAYS=10
WEATHER_MODELS=ecmwf_ifs025,best_match
# An outdoor chore doesn't go where the average chance of rain over it is higher, or any hour is hotter / sunnier
MAX_RAIN_PERCENT=20
MAX_FEELS_LIKE_C=35
MAX_UV_INDEX=7
# When the scheduler re-plans every day (local time; comma-separated, e.g. 07:00,20:00)
PLAN_TIMES=20:00

# Backups (`planner backup`, and before every scheduled run): folder for the dumps; unset = no backups.
# Needs mariadb-dump on PATH (the Docker image has it).
#BACKUP_DIR=./backups
#BACKUP_KEEP_DAYS=30
